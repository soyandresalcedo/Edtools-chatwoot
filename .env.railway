# Railway Environment Variables
# Copy these to Railway dashboard

# Rails
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
RAILS_MAX_THREADS=5

# Security (Railway will generate these)
SECRET_KEY_BASE=${{railway.SECRET_KEY_BASE}}
DEVISE_JWT_SECRET_KEY=${{railway.DEVISE_JWT_SECRET_KEY}}

# Database (Railway PostgreSQL)
DATABASE_URL=${{PostgreSQL.DATABASE_URL}}

# Redis (Railway Redis)  
REDIS_URL=${{Redis.REDIS_URL}}

# App URLs (use your actual Railway domain)
FRONTEND_URL=app.edtools.co
HELPCENTER_URL=app.edtools.co

# Disable services not needed for basic deployment
ENABLE_ACCOUNT_SIGNUP=true
FORCE_SSL=true

# Email (Amazon SES SMTP) - Configure in Railway dashboard
MAILER_SENDER_EMAIL=${{railway.MAILER_SENDER_EMAIL}}
SMTP_ADDRESS=${{railway.SMTP_ADDRESS}}
SMTP_USERNAME=${{railway.SMTP_USERNAME}}
SMTP_PASSWORD=${{railway.SMTP_PASSWORD}}
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_PORT=587

# Storage (AWS S3)
ACTIVE_STORAGE_SERVICE=amazon

# AWS S3 Configuration (set these in Railway dashboard)
AWS_ACCESS_KEY_ID=${{railway.AWS_ACCESS_KEY_ID}}
AWS_SECRET_ACCESS_KEY=${{railway.AWS_SECRET_ACCESS_KEY}}
AWS_REGION=us-east-2
S3_BUCKET_NAME=edtools-storage-railway

# Branding
BRAND_NAME=Edtools
BRAND_URL=https://edtools.co

# Disable external services for basic setup
FB_VERIFY_TOKEN=
FB_APP_SECRET=
FB_APP_ID=
TWITTER_APP_ID=
SLACK_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=