# Development configuration for local setup
SECRET_KEY_BASE=your-development-secret-key-base-can-be-anything-for-local-development
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true

# Local Redis (default Redis installation)
REDIS_URL=redis://localhost:6379

# Local PostgreSQL 
DATABASE_URL=postgresql://localhost/chatwoot_development
RAILS_ENV=development
RAILS_MAX_THREADS=5

# Mail settings for development (optional - uses letter_opener)
MAILER_SENDER_EMAIL=Chatwoot <accounts@chatwoot.com>
LETTER_OPENER=true

# Storage
ACTIVE_STORAGE_SERVICE=local

# Log settings
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Development only
WEBPACKER_DEV_SERVER_PUBLIC=localhost:3036