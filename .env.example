# Ejemplo de configuración para desarrollo local
SECRET_KEY_BASE=your-development-secret-key-base-can-be-anything-for-local-development
FRONTEND_URL=http://localhost:3000
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=true

# Local PostgreSQL 
POSTGRES_DATABASE=chatwoot_development
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Local Redis
REDIS_URL=redis://localhost:6379

RAILS_ENV=development
RAILS_MAX_THREADS=5
ACTIVE_STORAGE_SERVICE=local
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# Para desarrollo frontend
WEBPACKER_DEV_SERVER_PUBLIC=localhost:3036